# ======================================================================
# G5: Head-on, same FL
# Two aircraft on reciprocal headings at FL370, ~60 NM apart.
# Closing speed ~960 kt → ~3.75 min to meet. Fast geometry.
# Expect: rapid conflict, head-on singularity in MVP.
# ======================================================================
#00:00:00.00>CALL Nils\asas_nat\test_ASAS_config_vert.scn
#00:00:00.00>CALL Nils\asas_nat\test_ASAS_config_noreso.scn
00:00:00.00>CALL Nils\asas_nat\test_ASAS_config_nat.scn
#
# AC001: B77W eastbound at FL370
# AC002: A333 westbound at FL370, same track line
#
00:00:00.00>CRE AC001 B77W 53.0 -31.0 090 FL370 480
00:00:00.00>CRE AC002 A333 53.0 -29.0 270 FL370 480
00:00:00.00>LNAV AC001 OFF
00:00:00.00>LNAV AC002 OFF
#
00:00:00.00>FF
00:20:00.00>HOLD
