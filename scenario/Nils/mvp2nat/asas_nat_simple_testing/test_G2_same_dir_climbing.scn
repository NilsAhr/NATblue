# ======================================================================
# G2: Same-direction, one climbing through other's FL
# Rear aircraft climbing from FL350 through FL370 where cruiser flies.
# Expect: vertical PZ intrusion risk during climb-through.
# ======================================================================
#00:00:00.00>CALL Nils\asas_nat\test_ASAS_config_vert.scn
#00:00:00.00>CALL Nils\asas_nat\test_ASAS_config_noreso.scn
00:00:00.00>CALL Nils\asas_nat\test_ASAS_config_nat.scn
#
# AC001: B77W cruising at FL370, heading 090 (eastbound), M0.84
# AC002: A333 climbing from FL350, heading 090, same speed
# AC002 starts 10 NM behind and 2000 ft below
#
00:00:00.00>CRE AC001 B77W 53.0 -30.0 090 FL370 480
00:00:00.00>CRE AC002 A333 53.0 -30.0 090 FL350 475
# Set AC002 to climb to FL390 (will cross FL370)
00:00:00.00>ALT AC002 FL390
00:00:00.00>VS AC002 1000
00:00:00.00>LNAV AC001 OFF
00:00:00.00>LNAV AC002 OFF
#
00:00:00.00>FF
00:30:00.00>HOLD
