# ======================================================================
# G9: Near service ceiling (FL410)
# Two aircraft at FL410 (near ceiling for most types) — head-on.
# Vertical margin nearly zero: cannot climb further.
# Expect: vertical resolution fails or is severely limited.
# ======================================================================
#00:00:00.00>CALL Nils\asas_nat\test_ASAS_config_vert.scn
#00:00:00.00>CALL Nils\asas_nat\test_ASAS_config_noreso.scn
# CALL disabled: path Nils\asas_nat\ no longer exists (now Nils\mvp2nat\asas_nat_simple_testing\)
# and it would override the caller's resolver. ASAS config is set by the batch/parent scenario.
#00:00:00.00>CALL Nils\mvp2nat\asas_nat_simple_testing\test_ASAS_config_nat.scn
#
# AC001: B77W at FL410, heading 090, 460 kt
# AC002: A333 at FL410, heading 270, 460 kt
# Both at ceiling — vertical resolution can only descend
#
00:00:00.00>CRE AC001 B77W 53.0 -31.0 090 FL410 460
00:00:00.00>CRE AC002 A333 53.0 -29.0 270 FL410 460
00:00:00.00>LNAV AC001 OFF
00:00:00.00>LNAV AC002 OFF
#
00:00:00.00>FF
00:20:00.00>HOLD
