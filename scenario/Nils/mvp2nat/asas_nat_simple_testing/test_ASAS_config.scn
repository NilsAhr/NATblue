# ======================================================================
# ASAS_NAT common configuration — included by all test scenarios
# ======================================================================
# Detection
00:00:00.00>plugin load loggerff_asas
00:00:00.00>CDMETHOD STATEBASED
# Resolution  (change to MVP_NAT when ready)
00:00:00.00>RESO MVP
# Protected zones — start with 5 NM continental, increase to 14 NM later
00:00:00.00>ZONER 5
00:00:00.00>ZONEDH 1000
# Lookahead 5 min
00:00:00.00>DTLOOK 300
# Resolution margins
00:00:00.00>RFACH 1.05
00:00:00.00>RFACV 1.05
# Logger
00:00:00.00>STARTLOG
