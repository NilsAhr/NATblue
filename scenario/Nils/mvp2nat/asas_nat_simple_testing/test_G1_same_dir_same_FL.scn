# ======================================================================
# G1: Same-direction, same FL
# Two eastbound aircraft at FL370, rear one ~20 kt faster.
# Expect: overtake conflict, slow closing speed, long duration.
# ======================================================================
#00:00:00.00>CALL Nils\asas_nat\test_ASAS_config_vert.scn
#00:00:00.00>CALL Nils\asas_nat\test_ASAS_config_noreso.scn
00:00:00.00>CALL Nils\asas_nat\test_ASAS_config_nat.scn
#
# AC001: B77W at FL370, M0.84 ≈ 480 kt, heading 090 (eastbound)
# AC002: A333 at FL370, M0.82 ≈ 460 kt, heading 090 (eastbound)
# AC002 is 30 NM ahead — AC001 will overtake
#
00:00:00.00>CRE AC001 B77W 53.0 -30.0 090 FL370 480
00:00:00.00>CRE AC002 A333 53.0 -29.5 090 FL370 460
# LNAV off — fly straight ahead
00:00:00.00>LNAV AC001 OFF
00:00:00.00>LNAV AC002 OFF
#
# Run for 60 minutes (overtake takes time at ~20 kt closing speed)
00:00:00.00>FF
01:00:00.00>HOLD
