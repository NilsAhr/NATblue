# ======================================================================
# G6: Head-on, laterally offset
# Opposing traffic on adjacent parallel tracks, same FL.
# Close enough to trigger conflict but not perfectly head-on.
# Expect: near head-on with lateral component, bouncing risk.
# ======================================================================
#00:00:00.00>CALL Nils\asas_nat\test_ASAS_config_vert.scn
#00:00:00.00>CALL Nils\asas_nat\test_ASAS_config_noreso.scn
00:00:00.00>CALL Nils\asas_nat\test_ASAS_config_nat.scn
#
# AC001: B77W eastbound at FL370, lat 53.00
# AC002: A333 westbound at FL370, lat 53.04 (~2.5 NM north)
#
00:00:00.00>CRE AC001 B77W 53.00 -31.0 090 FL370 480
00:00:00.00>CRE AC002 A333 53.04 -29.0 270 FL370 480
00:00:00.00>LNAV AC001 OFF
00:00:00.00>LNAV AC002 OFF
#
00:00:00.00>FF
00:20:00.00>HOLD
