# ======================================================================
# G10: Multi-aircraft cluster (4 aircraft)
# Two eastbound + two westbound, arranged so conflicts cascade.
# Expect: simultaneous conflicts, potential bouncing / chain effects.
# ======================================================================
#00:00:00.00>CALL Nils\asas_nat\test_ASAS_config_vert.scn
#00:00:00.00>CALL Nils\asas_nat\test_ASAS_config_noreso.scn
# CALL disabled: path Nils\asas_nat\ no longer exists (now Nils\mvp2nat\asas_nat_simple_testing\)
# and it would override the caller's resolver. ASAS config is set by the batch/parent scenario.
#00:00:00.00>CALL Nils\mvp2nat\asas_nat_simple_testing\test_ASAS_config_nat.scn
#
# Eastbound pair
00:00:00.00>CRE EB01 B77W 53.00 -32.0 092 FL370 480
00:00:00.00>CRE EB02 A333 53.2 -32.0 088 FL370 475
# Westbound pair
00:00:00.00>CRE WB01 B77W 53.00 -28.0 268 FL370 480
00:00:00.00>CRE WB02 A333 53.2 -28.0 272 FL370 475
#
00:00:00.00>LNAV EB01 OFF
00:00:00.00>LNAV EB02 OFF
00:00:00.00>LNAV WB01 OFF
00:00:00.00>LNAV WB02 OFF
#
00:00:00.00>FF
